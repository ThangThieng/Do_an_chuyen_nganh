# Sao chép file này thành .env rồi điền giá trị thật. KHÔNG commit file .env.

# ===== CSDL phân tích (đích của ETL: 3 bảng fact) – PostgreSQL 18 local =====
ANALYTICS_DB_HOST=localhost
ANALYTICS_DB_PORT=5432
ANALYTICS_DB_NAME=lms_analytics
ANALYTICS_DB_USER=postgres
ANALYTICS_DB_PASSWORD=
# Database có sẵn dùng để kết nối khi cần tạo lms_analytics lần đầu
ANALYTICS_DB_MAINTENANCE_DB=postgres

# ===== CSDL nguồn Moodle rút gọn (bảng mdl_*) – dùng từ Bước 2 =====
MOODLE_DB_HOST=localhost
MOODLE_DB_PORT=5432
MOODLE_DB_NAME=moodle_src
MOODLE_DB_USER=postgres
MOODLE_DB_PASSWORD=
MOODLE_DB_MAINTENANCE_DB=postgres

# ===== Ứng dụng =====
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Thời điểm tham chiếu thay cho now() của mock data và ETL (ISO 8601).
#   Để trống            -> dùng thời gian thực (vận hành thật).
#   2026-11-06T10:30:00+07:00 -> demo giữa học kỳ (tuần 9 của HK1 bắt đầu 07/09/2026).
LMS_AS_OF=2026-11-06T10:30:00+07:00

# ===== Backend API – Bước 3 =====
# Khóa ký JWT, BẮT BUỘC, >= 32 ký tự. Tạo: python -c "import secrets; print(secrets.token_urlsafe(48))"
BACKEND_JWT_SECRET=
BACKEND_JWT_EXPIRE_MINUTES=480
# Các origin frontend được gọi API (phân tách bằng dấu phẩy)
BACKEND_CORS_ORIGINS=http://localhost:5173
BACKEND_CACHE_TTL_SECONDS=60
# Font TrueType có dấu tiếng Việt cho PDF (để trống: Arial trên Windows / DejaVu Sans trên Linux)
BACKEND_PDF_FONT=
BACKEND_PDF_FONT_BOLD=
BACKEND_PDF_MAX_ROWS=5000
BACKEND_EXCEL_MAX_ROWS=200000
# Mật khẩu ban đầu khi chạy: python -m backend.app.cli sync-users
BACKEND_SEED_PASSWORD=

# ===== Trung tâm can thiệp – kênh gửi tin (v1.2, xem common/messaging/config.py) =====
# Email: file = ghi .eml vào MAIL_FILE_DIR (demo offline) | smtp = gửi qua máy chủ thư | off = tắt
MAIL_TRANSPORT=file
MAIL_FILE_DIR=var/mail_outbox
# SMTP (khi MAIL_TRANSPORT=smtp). Gmail: smtp.gmail.com 587 starttls + mật khẩu ứng dụng; Microsoft 365: smtp.office365.com 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=canhbao.lms@dlu.edu.vn
MAIL_FROM_NAME=Hệ thống cảnh báo học tập
# redirect = mọi email tới MAIL_REDIRECT_TO (kiểm thử an toàn) | live = tới sinh viên thật (cần đủ điều kiện gửi thật)
MAIL_DELIVERY=redirect
MAIL_REDIRECT_TO=
# Moodle Web Service (REST). Demo: Moodle mô phỏng `python -m tools.moodle_ws_stub` (token mặc định lms-analytics-demo-token)
MOODLE_WS_URL=http://127.0.0.1:8091
MOODLE_WS_TOKEN=lms-analytics-demo-token
# Địa chỉ Moodle mà trình duyệt mở được (liên kết "Xem như sinh viên"); để trống = MOODLE_WS_URL
MOODLE_WS_PUBLIC_URL=
# stub = Moodle mô phỏng | live = Moodle thật của trường
MOODLE_WS_ENV=stub
# Gửi tới người nhận THẬT chỉ khi: true + LMS_AS_OF trống + kênh đã kiểm tra thành công (Hệ thống › Kênh gửi tin)
MESSAGING_ALLOW_LIVE=false
MESSAGING_QUIET_HOURS=22-6
MESSAGING_DAILY_LIMIT_PER_COURSE=300
