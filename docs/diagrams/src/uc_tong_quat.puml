    usecase "UC05 Theo dõi lưu lượng truy cập" as UC05
    usecase "UC06 Xuất báo cáo Excel/PDF" as UC06
    usecase "UC07 Tra cứu danh mục môn học" as UC07
    usecase "UC08 Quản lý người dùng" as UC08
    usecase "UC09 Xem nhật ký ETL" as UC09
    usecase "UC10 Sao lưu dữ liệu" as UC10
