!pragma layout smetana
skinparam dpi 200
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor white
skinparam ArrowColor #333333
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBorderColor #333333
skinparam UsecaseBackgroundColor #F4F7FB
skinparam RectangleBorderColor #333333
skinparam PackageBorderColor #555555
skinparam ClassBorderColor #333333
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassHeaderBackgroundColor #E8EEF7
skinparam NoteBackgroundColor #FFFBE6
skinparam NoteBorderColor #B8A04A
skinparam SequenceLifeLineBorderColor #777777
skinparam ParticipantBackgroundColor #F4F7FB
skinparam ParticipantBorderColor #333333
skinparam StateBackgroundColor #F4F7FB
skinparam StateBorderColor #333333
skinparam ActivityBackgroundColor #F4F7FB
skinparam ActivityBorderColor #333333
skinparam ComponentBackgroundColor #F4F7FB
skinparam ComponentBorderColor #333333
skinparam NodeBackgroundColor #FFFFFF
skinparam DatabaseBackgroundColor #F4F7FB
